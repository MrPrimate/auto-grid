{
  "name": "auto-grid",
  "version": "0.1.2",
  "author": "MrPrimate",
  "description": "Foundry VTT module for detecting and applying scene grids from map images.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint src/",
    "lint-fix": "eslint src/ --fix",
    "test": "node --test tools/test-grid-detector.mjs",
    "typecheck": "tsc --noEmit",
    "dev:foundryLinks": "node ./tools/create-symlinks.mjs",
    "dev:link": "node ./tools/foundry-dev-link.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.1",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "js-yaml": "^4.2.0",
    "prompts": "^2.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
